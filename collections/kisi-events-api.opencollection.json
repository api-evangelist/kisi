{
  "opencollection": "1.0.0",
  "info": {
    "name": "Kisi Calendars Events API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Events",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Fetch Event Metadata",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.kisi.io/events/meta",
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Fetch Event Metadata"
        },
        {
          "info": {
            "name": "Fetch Event Types",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.kisi.io/events/types",
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Fetch Event Types"
        }
      ]
    }
  ],
  "bundled": true
}