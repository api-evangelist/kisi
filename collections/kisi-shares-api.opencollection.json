          },
          "http": {
            "method": "GET",
            "url": "https://api.kisi.io/shares",
            "params": [
              {
                "name": "ids",
                "value": "",
                "type": "query",
                "description": "Filter by object IDs"
              },
              {
                "name": "query",
                "value": "",
                "type": "query",
                "description": "Filter by a freetext string. Properties searched: `user.email`, `user.name`\n"
              },
              {
                "name": "group_id",
                "value": "",
                "type": "query",
                "description": "Filter by group ID"
              },
              {
                "name": "member_id",
                "value": "",
                "type": "query",
                "description": "Filter by member ID"
              },
              {
                "name": "place_id",
                "value": "",
                "type": "query",
                "description": "Filter by place ID"
              },
              {
                "name": "user_id",
                "value": "",
                "type": "query",
                "description": "Filter by user ID or by current user if value is `me`."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "The number of objects to return"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "The number of objects to offset"
              },
              {
                "name": "role_id",
                "value": "",
                "type": "query",
                "description": "Filter by the role of the share"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
